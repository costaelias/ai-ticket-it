{
  "expo": {
    "name": "AI Ticket It",
    "slug": "ai-ticket-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "android": {
      "package": "com.aiticketit.app",
      "usesCleartextTraffic": true
    },
    "ios": {
      "bundleIdentifier": "com.aiticketit.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
