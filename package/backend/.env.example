# Copiá este archivo como .env y ajustá los valores.

# Puerto en el que escucha la API
PORT=4000

# Interfaz de red (0.0.0.0 permite conectar desde el emulador o un celular de la red local)
HOST=0.0.0.0

# Orígenes permitidos por CORS, separados por coma (* permite cualquiera)
CORS_ORIGINS=*

# Duración de la sesión (token) en horas
DURACION_SESION_HORAS=8

# Carga usuarios, eventos y compras de ejemplo al iniciar (true | false)
CARGAR_DATOS_EJEMPLO=true
